{
  "name": "browserreflex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm --filter=@browserreflex/server run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check-licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
